DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.azurewebsites.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app-name.azurewebsites.net
DJANGO_SECURE_SSL_REDIRECT=True
WEBSITE_NAME=Force Sales
MAIN_STYLE_COLOR=#0b5cab
SECONDARY_STYLE_COLOR=#35a1ff
THIRD_STYLE_COLOR=#20c997
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Optional one-time admin bootstrap. Set these in Azure settings, never in Git.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=<choose-a-unique-password>
# DJANGO_SUPERUSER_EMAIL=
# With DATABASE_URL unset, Azure uses /home/site/data/db.sqlite3.
# DJANGO_SQLITE_PATH=/home/site/data/db.sqlite3
